{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/windvex/wisp-dapp-registry/main/schema/chains.schema.json",
  "title": "Wisp DApp Registry Chains",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "chains"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "namespace", "chainId", "icon"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "namespace": {
            "enum": ["antelope", "bitcoin", "evm", "solana", "tron"]
          },
          "chainId": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "pattern": "^assets/chains/[a-z0-9]+(?:-[a-z0-9]+)*\\.(png|webp)$"
          }
        }
      }
    }
  }
}
