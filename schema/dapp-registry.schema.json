{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/windvex/wisp-dapp-registry/main/schema/dapp-registry.schema.json",
  "title": "Wisp DApp Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dapps"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "dapps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dapp"
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "dapp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "url",
        "icon",
        "chains",
        "categories",
        "developer",
        "status",
        "featured",
        "verified",
        "addedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 160
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "icon": {
          "type": "string",
          "pattern": "^assets/dapps/[a-z0-9]+(?:-[a-z0-9]+)*\\.(png|webp)$"
        },
        "chains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bridge",
              "defi",
              "explorer",
              "games",
              "governance",
              "marketplace",
              "nft",
              "social",
              "tools",
              "wallet"
            ]
          }
        },
        "developer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "url": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        },
        "status": {
          "enum": ["active", "beta", "inactive"]
        },
        "featured": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "addedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
